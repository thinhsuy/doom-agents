# Copy to .env.local and fill in. .env.local is gitignored.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=doom_agents
PGUSER=doom_agents
PGPASSWORD=<generated — see company/db/README.md>
DATABASE_URL=postgresql://doom_agents:<password>@127.0.0.1:5432/doom_agents

# --- LLM providers (agents reply in chat via these) ---
# GPT:
OPENAI_API_KEY=
# Claude via AWS Bedrock:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Optional overrides (backend reads these; defaults shown):
# DEFAULT_PROVIDER=claude         # gpt | claude — for agents without a per-agent config
# DEFAULT_MODEL=haiku             # claude aliases: haiku|sonnet ; gpt: gpt-4o-mini|gpt-4o
# Newer Claude on Bedrock needs a cross-region INFERENCE PROFILE id (prefix
# global./apac.), NOT the raw model id — raw id → "invalid model identifier".
# Discover yours: aws bedrock list-inference-profiles --region <r>. Verified working:
# BEDROCK_REGION=ap-southeast-1
# BEDROCK_HAIKU=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_SONNET=global.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_PORT=
AWS_S3_USE_PATH_STYLE_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=

AUTH_CEO_PASSWORD=
AUTH_CTO_PASSWORD=
AUTH_COO_PASSWORD=
AUTH_CIO_PASSWORD=